+        if (action == CryptoChannel.CONTROL_WAKE) {
+            ControlLink ctl = controlLink;
+            if (ctl != null && ctl.isConnected()) {
+                new Thread(() -> {
+                    try { ctl.send(CryptoChannel.TYPE_CONTROL, new byte[]{action}); }
